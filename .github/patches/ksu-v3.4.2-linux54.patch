diff --git a/kernel/include/nova_compat.h b/kernel/include/nova_compat.h
new file mode 100644
index 0000000..bff05d3
--- /dev/null
+++ b/kernel/include/nova_compat.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef KSU_NOVA_COMPAT_H
+#define KSU_NOVA_COMPAT_H
+#include <linux/version.h>
+#include <linux/task_work.h>
+/* The Nova build backports the Linux 5.10 SELinux policy engine. */
+#define KSU_NOVA_SELINUX_510 1
+/* Nova 5.4 uses task_work_add(..., bool notify); true requests resume notification. */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 9, 0)
+#define TWA_RESUME true
+#endif
+#endif
diff --git a/kernel/manager/pkg_observer.c b/kernel/manager/pkg_observer.c
index 670918f..275a582 100644
--- a/kernel/manager/pkg_observer.c
+++ b/kernel/manager/pkg_observer.c
@@ -69,9 +69,22 @@ static int ksu_handle_inode_event(struct fsnotify_mark *mark, u32 mask,
     return 0;
 }
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 9, 0)
+static int ksu_handle_event(struct fsnotify_group *group, struct inode *inode,
+                            u32 mask, const void *data, int data_type,
+                            const struct qstr *name, u32 cookie,
+                            struct fsnotify_iter_info *iter_info)
+{
+    return ksu_handle_inode_event(NULL, mask, inode, NULL, name, cookie);
+}
+static const struct fsnotify_ops ksu_ops = {
+    .handle_event = ksu_handle_event,
+};
+#else
 static const struct fsnotify_ops ksu_ops = {
-	.handle_inode_event = ksu_handle_inode_event,
+    .handle_inode_event = ksu_handle_inode_event,
 };
+#endif
 
 static int add_mark_on_inode(struct inode *inode, u32 mask,
                              struct fsnotify_mark **out)
