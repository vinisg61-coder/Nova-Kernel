diff --git a/kernel/selinux/selinux.c b/kernel/selinux/selinux.c
index 1a76dbd..67f999b 100644
--- a/kernel/selinux/selinux.c
+++ b/kernel/selinux/selinux.c
@@ -89,6 +89,14 @@ static void ksu_security_release_secctx(char *secdata, u32 seclen)
  * string-based comparison path; this degrades performance only and
  * does not cause a functional failure.
  */
+#ifdef CONFIG_KSU_SUSFS
+u32 susfs_ksu_sid __read_mostly;
+u32 susfs_priv_app_sid __read_mostly;
+bool susfs_is_current_ksu_domain(void)
+{
+    return is_ksu_domain();
+}
+#endif
 static u32 cached_su_sid __read_mostly = 0;
 static u32 cached_zygote_sid __read_mostly = 0;
 static u32 cached_init_sid __read_mostly = 0;
@@ -190,6 +198,10 @@ static void __ksu_security_release_secctx(struct lsm_context *cp)
 void cache_sid(void)
 {
     int err;
+#ifdef CONFIG_KSU_SUSFS
+    ksu_security_secctx_to_secid(KERNEL_SU_CONTEXT, strlen(KERNEL_SU_CONTEXT), &susfs_ksu_sid);
+    ksu_security_secctx_to_secid("u:r:priv_app:s0", strlen("u:r:priv_app:s0"), &susfs_priv_app_sid);
+#endif
 
     err = ksu_security_secctx_to_secid(KERNEL_SU_CONTEXT, strlen(KERNEL_SU_CONTEXT),
                                    &cached_su_sid);
