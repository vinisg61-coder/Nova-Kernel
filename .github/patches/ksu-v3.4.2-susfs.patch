diff --git a/kernel/Kconfig b/kernel/Kconfig
index 88e2281..d1d863b 100644
--- a/kernel/Kconfig
+++ b/kernel/Kconfig
@@ -43,4 +43,51 @@ config KSU_X86_PATCH_SYSCALL_DISPATCHER
 	  Dynamically patch x64's hardened syscall dispatcher to support syscall hooks. This is a
 	  replacement for a kernel source code patch, and is useful for x86_64 LKM mode.
 
+menu "KernelSU - SUSFS"
+config KSU_SUSFS
+	bool "Build SUSFS filesystem integration"
+	depends on KSU = y && ARM64 && THREAD_INFO_IN_TASK
+	default n
+
+if KSU_SUSFS
+
+config KSU_SUSFS_SUS_PATH
+	bool "Hide configured paths"
+	default y
+
+config KSU_SUSFS_SUS_MOUNT
+	bool "Hide SUSFS mounts"
+	default y
+
+config KSU_SUSFS_SUS_KSTAT
+	bool "Spoof configured file metadata"
+	default y
+
+config KSU_SUSFS_SPOOF_UNAME
+	bool "Spoof uname"
+	default y
+
+config KSU_SUSFS_ENABLE_LOG
+	bool "SUSFS logging"
+	default y
+
+config KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+	bool "Hide KSU and SUSFS kallsyms entries"
+	default y
+
+config KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	bool "Spoof cmdline or bootconfig"
+	default y
+
+config KSU_SUSFS_OPEN_REDIRECT
+	bool "Redirect configured file opens"
+	default y
+
+config KSU_SUSFS_SUS_MAP
+	bool "Hide configured file mappings"
+	default y
+
+endif
+endmenu
+
 endmenu
diff --git a/kernel/core/init.c b/kernel/core/init.c
index 87a17ef..18314da 100644
--- a/kernel/core/init.c
+++ b/kernel/core/init.c
@@ -2,6 +2,9 @@
 #include <linux/fs.h>
 #include <linux/kobject.h>
 #include <linux/module.h>
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs.h>
+#endif
 #include <linux/rcupdate.h>
 #include <linux/sched.h>
 #include <linux/workqueue.h>
@@ -140,6 +143,9 @@ int __init kernelsu_init(void)
 	}
 
 	ksu_init_symbol_resolver();
+#ifdef CONFIG_KSU_SUSFS
+	susfs_init();
+#endif
 	ksu_syscall_hook_init();
 
 	// Block modules early, before vendor modules are loaded in second stage.
diff --git a/kernel/hook/setuid_hook.c b/kernel/hook/setuid_hook.c
index 3cccc78..73c90d9 100644
--- a/kernel/hook/setuid_hook.c
+++ b/kernel/hook/setuid_hook.c
@@ -11,6 +11,12 @@
 #include <linux/types.h>
 #include <linux/uaccess.h>
 #include <linux/uidgid.h>
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs_def.h>
+#include <linux/workqueue.h>
+#include "selinux/selinux.h"
+extern struct work_struct susfs_extra_works;
+#endif
 
 #include "policy/allowlist.h"
 #include "hook/setuid_hook.h"
@@ -50,6 +56,20 @@ int ksu_handle_setresuid(uid_t old_uid, uid_t new_uid)
         ksu_clear_task_tracepoint_flag_if_needed(current);
     }
 
+#ifdef CONFIG_KSU_SUSFS
+    if (ksu_is_allow_uid_for_current(new_uid)) {
+        susfs_clear_current_proc_no_su();
+        susfs_clear_current_proc_umounted();
+        susfs_clear_current_proc_umounted_for_zygote_next();
+    } else {
+        susfs_set_current_proc_no_su();
+        if (new_uid >= 10000 && is_zygote(current_cred()) &&
+            ksu_uid_should_umount(new_uid)) {
+            susfs_set_current_proc_umounted();
+            schedule_work(&susfs_extra_works);
+        }
+    }
+#endif
     // Handle kernel umount
     ksu_handle_umount(old_uid, new_uid);
 
