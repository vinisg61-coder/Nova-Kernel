CONFIG_SEC_A52SXQ_PROJECT=y
CONFIG_MACH_A52SXQ_EUR_OPEN=y
CONFIG_SEC_NFC=y
CONFIG_SEC_NFC_DUPLICATED_IRQ_WQ_QC=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
CONFIG_LEDS_SM5714=y
CONFIG_SENSORS_SX9364=y
CONFIG_LSM6DSO_FACTORY=y
CONFIG_STK31610_FACTORY=y
CONFIG_FLIP_COVER_DETECTOR_FACTORY=y
# CONFIG_PDIC_PD30 is not set
CONFIG_SENSORS_FINGERPRINT=y
CONFIG_SENSORS_ET7XX=y
CONFIG_INPUT_HALL_IC=y
CONFIG_HALL_NOTIFIER=y
CONFIG_HALL_LOGICAL=y
CONFIG_CHARGER_PCA9468=y
CONFIG_SEND_PDMSG_IN_PPS_REQUEST_WORK=y
CONFIG_CHARGER_SM5714=y
CONFIG_FUELGAUGE_SM5714=y
CONFIG_KPERFMON_BUILD=m
CONFIG_MFD_SM5714=y
CONFIG_MUIC_SM5714=y
CONFIG_MUIC_BCD_RESCAN=y
# CONFIG_MUIC_QC_DISABLE is not set
CONFIG_PDIC_SM5714=y
CONFIG_SM5714_FACTORY_MODE=y
CONFIG_SM5714_WATER_DETECTION_ENABLE=y
CONFIG_SM5714_SUPPORT_SBU=y
# CONFIG_SM5714_DISABLE_PD is not set
CONFIG_SECURITY_DSMS=y
CONFIG_SAMSUNG_OIS_MCU_STM32=y
CONFIG_SAMSUNG_OIS_Z_AXIS_CAL=y
CONFIG_SAMSUNG_REAR_QUADRA=y
CONFIG_SAMSUNG_SUPPORT_MULTI_MODULE=y
CONFIG_PANEL_S6E3FC3_AMS646YD01_LO_FHD=y

# ════════════════════════════════════════════════════════════════
#  NovaKernel — A52s battery & performance tuning
#
#  This fragment is merged AFTER nova_defconfig, so everything here
#  overrides the base config. It only affects a52sxq; a73xq/m52xq
#  keep the stock behaviour.
# ════════════════════════════════════════════════════════════════

# ── Networking: congestion control ──────────────────────────────
# The base config shipped BIC as the default TCP congestion
# control. BIC is a 1990s high-BDP algorithm: it probes bandwidth
# aggressively and collapses on the variable-RTT links a phone
# actually sees (LTE/5G/Wi-Fi), costing extra round trips and
# therefore radio-on time. BBR paces the send rate from measured
# bandwidth/RTT instead.
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_BIC is not set

# ── Networking: queueing discipline ────────────────────────────
# pfifo_fast (the old default) has no AQM, so a fast sender fills
# the modem/Wi-Fi queue and adds hundreds of ms of latency.
# fq_codel is the upstream-recommended default; CAKE and FQ are
# built in so they can still be selected per-interface at runtime.
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y

# ── Storage ────────────────────────────────────────────────────
# Kyber aims at a latency budget rather than raw throughput, which
# keeps UI/foreground reads responsive while background writes run.
CONFIG_MQ_IOSCHED_KYBER=y

# ── Battery: drop always-on logging & tracing ──────────────────
# Everything below costs CPU time, memory and wakeups on every
# boot / context switch / clock vote, and is only useful while
# actively debugging. Every call site is #ifdef-guarded, so these
# only compile the feature out — they do not remove any hardware
# support.

# Keeps 16 live log contexts and encodes every GLINK / IPA / RPM
# message into them.
# CONFIG_IPC_LOGGING is not set

# Writes to an *uncached* ring buffer from the logging hot path,
# so every entry is an uncached memory write.
# CONFIG_QCOM_RTB is not set
# CONFIG_QCOM_RTB_QGKI is not set
# CONFIG_QCOM_RTB_SEPARATE_CPUS is not set

# Samsung scheduler logging records task/IRQ scheduling history on
# every context switch. Samsung itself ships it default n.
# CONFIG_SEC_DEBUG_SCHED_LOG is not set
# CONFIG_SEC_DEBUG_SCHED_LOG_PER_CPU is not set
# CONFIG_SEC_DEBUG_SCHED_LOG_IRQ_V2 is not set
# CONFIG_SEC_DEBUG_DUMP_TASK_STACK is not set

# Hooks clk_set_rate() and records every frequency/voltage vote
# made anywhere in the kernel.
# CONFIG_SEC_DEBUG_APPS_CLK_LOGGING is not set

# Per-task / per-runqueue accounting, only ever read from debugfs.
# CONFIG_SCHEDSTATS is not set

# Always-on debug instrumentation with no runtime benefit.
# CONFIG_DEBUG_STACK_USAGE is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_FUNCTION_ERROR_INJECTION is not set

# Verbose per-event driver logs (USB / touch / camera / ntfs).
# CONFIG_USB_DEBUG_DETAILED_LOG is not set
# CONFIG_USB_NOTIFY_PROC_LOG is not set
# CONFIG_SEC_DEBUG_TSP_LOG is not set
# CONFIG_CAMERA_FRAME_CNT_DBG is not set
# CONFIG_CAMERA_FRAME_CNT_CHECK is not set
# CONFIG_NTFS_DEBUG is not set
